{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yendory Studio",
  "version": "0.7.9",
  "identifier": "org.yendory.studio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yendory Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Create, teach and examine Bicameral AI models",
    "longDescription": "Yendory Studio teaches Bicameral neural models (Transformer + Dense + interconnect) with your own lessons, using the shared Yendory Engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
