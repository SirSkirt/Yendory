{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yendory Tools",
  "version": "0.1.5",
  "identifier": "org.yendory.tools",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yendory Tools",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Games and apps for trained Yendory models",
    "longDescription": "Yendory Tools puts trained Yendory models to work: they play games and use apps through Nexus, the Engine's actions and results.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
